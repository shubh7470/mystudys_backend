generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum AdminStatus {
  ACTIVE
  BLOCKED
}

model Admin {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String       @map("password_hash")
  role         AdminRole    @default(ADMIN)
  status       AdminStatus  @default(ACTIVE)
  avatarUrl    String?      @map("avatar_url")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  sessions     AdminSession[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  token     String   @unique
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model AcademicClass {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  code         String?
  slug         String   @unique
  displayOrder Int      @default(0) @map("display_order")
  stream       String?  // e.g. "General", "Science", "Commerce", "Arts"
  boards       String[] @default([]) // e.g. ["CBSE", "ICSE", "UP Board", "Bihar Board"]
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  materials      StudyMaterial[]
  materialGroups MaterialGroup[]

  @@index([displayOrder])
  @@index([isActive])
  @@map("academic_classes")
}

model MaterialCategory {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  icon         String?
  className    String   @map("class_name")
  stream       String?
  board        String   @default("CBSE")
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  books        MaterialBook[]

  @@index([className])
  @@index([stream])
  @@index([board])
  @@map("material_categories")
}

model MaterialBook {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  title        String
  medium       String   @default("English") // "English" | "Hindi"
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category     MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chapters     MaterialChapter[]

  @@index([categoryId])
  @@index([medium])
  @@map("material_books")
}

model MaterialChapter {
  id           String   @id @default(uuid()) @db.Uuid
  bookId       String   @map("book_id") @db.Uuid
  title        String
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  book         MaterialBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  materials    StudyMaterial[]

  @@index([bookId])
  @@map("material_chapters")
}

model MaterialGroup {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  classId      String?  @map("class_id") @db.Uuid
  className    String   @map("class_name")
  stream       String?
  board        String   @default("CBSE")
  displayOrder Int      @default(0) @map("display_order")
  isPublished  Boolean  @default(true) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  academicClass AcademicClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  headings      MaterialHeading[]
  materials     StudyMaterial[]

  @@index([className])
  @@index([stream])
  @@index([board])
  @@map("material_groups")
}

model MaterialHeading {
  id           String   @id @default(uuid()) @db.Uuid
  groupId      String   @map("group_id") @db.Uuid
  title        String
  medium       String   @default("English") // "English" | "Hindi"
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  group     MaterialGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  materials StudyMaterial[]

  @@index([groupId])
  @@index([medium])
  @@map("material_headings")
}

model StudyMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  headingId   String?  @map("heading_id") @db.Uuid
  chapterId   String?  @map("chapter_id") @db.Uuid

  title       String
  description String?
  fileUrl     String   @map("file_url")
  fileName    String?  @map("file_name")
  fileSize    Int?     @map("file_size")
  badgeColor  String?  @default("red") @map("badge_color")

  classId     String?  @map("class_id") @db.Uuid
  className   String   @map("class_name")
  stream      String?
  board       String
  medium      String   @default("English")
  subject     String?
  type        String   @default("Notes")

  isPublished Boolean  @default(true) @map("is_published")
  downloads   Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  academicClass AcademicClass?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  group         MaterialGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  heading       MaterialHeading? @relation(fields: [headingId], references: [id], onDelete: Cascade)
  chapter       MaterialChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([headingId])
  @@index([chapterId])
  @@index([className])
  @@index([stream])
  @@index([board])
  @@index([medium])
  @@map("study_materials")
}
